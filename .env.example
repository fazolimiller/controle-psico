# Segredo interno para assinar a sessão de login (gere com: openssl rand -hex 32)
APP_PASSWORD_HASH_SECRET=troque-por-uma-string-aleatoria

# Credenciais do admin inicial — criado automaticamente na primeira vez que o
# sistema roda, caso ainda não exista nenhum usuário no banco.
# Depois do primeiro login, recomenda-se trocar a senha pela tela de Administração.
ADMIN_LOGIN=admin
ADMIN_SENHA=troque-esta-senha
ADMIN_NOME=Administrador

# Banco de dados Postgres (produção — deixe em branco para usar SQLite local)
POSTGRES_URL=
