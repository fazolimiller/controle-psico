# =============================================================================
# Controle de Psicotrópicos — variáveis de ambiente
# =============================================================================
# Copie para ".env" no servidor e preencha. O arquivo .env NUNCA deve ir para o
# repositório (já está no .gitignore). Permissões recomendadas no Linux:
#   chown psico:psico .env && chmod 600 .env
# Nenhuma variável sensível tem valor padrão no código: se faltar, o sistema
# não inicia as operações e informa qual variável está ausente.
# =============================================================================

# --- Sessão (OBRIGATÓRIO) ----------------------------------------------------
# Segredo para assinar o cookie de sessão. Mínimo de 32 caracteres.
# Gere com:  openssl rand -hex 32
SESSION_SECRET=

# Encerramento da sessão por inatividade (minutos) e duração máxima (horas).
SESSION_IDLE_MINUTES=30
SESSION_MAX_HOURS=12

# Cookie "Secure" (só trafega em HTTPS). Padrão: ligado em produção.
# Só defina false se a aplicação for servida por HTTP puro (não recomendado).
# COOKIE_SECURE=true

# --- Login ---------------------------------------------------------------------
# Tentativas erradas antes do bloqueio temporário, e duração do bloqueio.
LOGIN_MAX_TENTATIVAS=5
LOGIN_BLOQUEIO_MINUTOS=15

# --- Banco de dados (OBRIGATÓRIO) ------------------------------------------------
# oracle (produção na Santa Casa) | postgres | sqlite (apenas desenvolvimento local)
DB_CLIENT=oracle

# Oracle — tabelas criadas pelo DBA com os scripts de db/oracle/
ORACLE_USER=PSICO_APP
ORACLE_PASSWORD=
# Formato Easy Connect: host:porta/serviço
ORACLE_CONNECT_STRING=servidor-oracle:1521/NOMESERVICO
# Esquema dono das tabelas, quando diferente do usuário de conexão
ORACLE_SCHEMA=PSICO_OWNER
# ORACLE_POOL_MIN=1
# ORACLE_POOL_MAX=10

# PostgreSQL (alternativa) — ex.: postgresql://usuario:senha@host:5432/banco
# POSTGRES_URL=

# --- Administrador inicial ---------------------------------------------------------
# Usado UMA única vez, quando não existe nenhum usuário no banco. O admin é
# criado com troca de senha obrigatória no primeiro acesso.
# APÓS O PRIMEIRO LOGIN, APAGUE ADMIN_SENHA DESTE ARQUIVO.
ADMIN_LOGIN=
ADMIN_SENHA=
ADMIN_NOME=Administrador
